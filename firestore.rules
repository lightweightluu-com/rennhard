rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admins: Dokument admins/{uid} manuell in der Konsole anlegen (beliebiger Inhalt).
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Öffentliche Inhalte: jeder liest, nur Admins schreiben
    match /{col}/{id} {
      allow read: if col in ['settings', 'pages', 'legal', 'services', 'team', 'vehicles'];
      allow write: if col in ['settings', 'pages', 'legal', 'services', 'team', 'vehicles'] && isAdmin();
    }

    // Kontaktformular: jeder darf (validiert) senden, nur Admins lesen/verwalten
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'company', 'phone', 'email', 'message', 'read', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() <= 5000
        && request.resource.data.read == false;
      allow read, update, delete: if isAdmin();
    }
  }
}
