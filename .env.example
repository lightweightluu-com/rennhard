# Firebase Web-App-Konfiguration (Firebase Console → Projekteinstellungen → Deine Apps)
# Solange diese Werte leer sind, läuft die Website mit den eingebauten Inhalten (src/content/seed.ts)
# und das Admin-Backend zeigt einen Einrichtungshinweis.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
